library(tidyverse)
library(zoo)
setwd("C:/Users/vipul/Desktop/MSc Project/New Folder/Testing Data/Vipul Dude/Modulus")
files <- list.files(pattern = "\\.txt$", recursive = TRUE, full.names = TRUE)
read_clean <- function(f) {
parts <- str_split(f, "/")[[1]]
n <- length(parts)
set_name <- parts[n - 2]     # "SET-1" / "SET-2"
material <- parts[n - 1]     # "CF PETG" / "PETG"
flow   <- str_extract(basename(f), "\\d+(?=%)")            # grabs 80/90/100/110 regardless of spacing
sample <- str_extract(basename(f), "(?<=_)\\d+(?=\\.txt$)") # grabs sample number before .txt
df <- read_tsv(f, skip = 1, locale = locale(encoding = "UTF-16LE"),
col_names = c("Time","Load","Ext","Stress","ExtPreload",
"Strain","PctStrain","GaugeLen"),
show_col_types = FALSE) %>%
drop_na(Stress, Strain) %>%
filter(Strain >= cummax(Strain))
smax <- max(df$Stress)
df <- df %>% filter(Stress > 0.02 * smax)
win <- df %>% filter(between(Strain, quantile(Strain, .05), quantile(Strain, .4)))
fit <- lm(Stress ~ Strain, data = win)
strain0 <- -coef(fit)[1] / coef(fit)[2]
df <- df %>% mutate(Strain = Strain - strain0) %>% filter(Strain >= 0)
df %>%
mutate(StressSmooth = rollmean(Stress, 5, fill = NA, align = "center"),
set = set_name, material = material, flow = flow, sample = sample)
}
all_data <- map_dfr(files, read_clean)
# sanity check before plotting - make sure nothing came back NA
all_data %>% distinct(set, material, flow, sample) %>% arrange(set, material, flow, sample) %>% print(n = 100)
mutate(StressSmooth = rollmean(Stress, 5, fill = NA, align = "center"),
set = set_name, material = material, flow = flow, sample = sample,
file = basename(f))
