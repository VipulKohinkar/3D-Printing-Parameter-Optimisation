# check if the "glitch strain" values cluster around the same point across multiple samples/flows
# (a consistent switch-over point would support "deliberate extensometer removal", not random slip)
all_data %>%
filter(material == "PETG") %>%
group_by(flow, sample) %>%
mutate(stress_drop = Stress - lag(Stress)) %>%
filter(stress_drop < -0.3) %>%   # flag any sudden drop greater than 0.3 MPa between consecutive points
select(flow, sample, Strain, Stress, stress_drop) %>%
arrange(flow, sample, Strain) %>%
print(n = 50)
# lower the threshold, and check magnitude of drops overall to calibrate
all_data %>%
filter(material == "PETG") %>%
group_by(flow, sample) %>%
mutate(stress_drop = Stress - lag(Stress)) %>%
ungroup() %>%
filter(stress_drop < 0) %>%
summarise(min_drop = min(stress_drop, na.rm = TRUE),
q05 = quantile(stress_drop, 0.01, na.rm = TRUE))
