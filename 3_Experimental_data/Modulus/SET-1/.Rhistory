setwd("C:/Users/vipul/Desktop/MSc Project/New Folder/Testing Data/Vipul Dude/Modulus/SET-1")
files <- list.files(pattern = "\\.txt$", recursive = TRUE, full.names = TRUE)
read_clean <- function(f) {
parts <- str_split(f, "/")[[1]]
material <- parts[length(parts) - 1]
flow   <- str_extract(basename(f), "\\d+(?=%)")
sample <- str_extract(basename(f), "(?<=_)\\d+(?=\\.txt$)")
df <- read_tsv(f, skip = 1, locale = locale(encoding = "UTF-16LE"),
col_names = c("Time","Load","Ext","Stress","ExtPreload",
"Strain","PctStrain","GaugeLen"),
show_col_types = FALSE) %>%
drop_na(Stress, Strain)
# FIX 1: non-monotonic glitches - strain must only increase
df <- df %>% filter(Strain >= cummax(Strain))
# FIX 2: preload noise - drop rows before stress is meaningfully above zero
smax <- max(df$Stress)
df <- df %>% filter(Stress > 0.02 * smax)
# FIX 3: toe correction - fit the clean elastic region, shift so it starts at true (0,0)
win <- df %>% filter(between(Strain, quantile(Strain, .05), quantile(Strain, .4)))
fit <- lm(Stress ~ Strain, data = win)
strain0 <- -coef(fit)[1] / coef(fit)[2]
df <- df %>% mutate(Strain = Strain - strain0) %>% filter(Strain >= 0)
# light smoothing for a cleaner visual line (doesn't change the modulus calc)
df %>%
mutate(StressSmooth = rollmean(Stress, 5, fill = NA, align = "center"),
material = material, flow = flow, sample = sample, file = basename(f))
}
all_data <- map_dfr(files, read_clean)
View(all_data)
# CHECK 1: labeling correct?
all_data %>% distinct(material, flow, sample, file) %>% arrange(material, flow, sample) %>% print(n = 100)
# CHECK 2: is the elastic region actually linear? (R² close to 1 = good)
all_data %>%
filter(Strain >= quantile(Strain, .05), Strain <= quantile(Strain, .4)) %>%
group_by(material, flow, sample) %>%
summarise(r2 = summary(lm(Stress ~ Strain))$r.squared, .groups = "drop") %>%
arrange(r2) %>%
print(n = 100)
# CHECK 3: does every curve start near (0,0) after toe correction?
all_data %>% group_by(material, flow, sample) %>% slice_min(Strain, n = 1) %>%
select(material, flow, sample, Strain, Stress) %>% print(n = 100)
strain_grid <- seq(0, 0.005, length.out = 200)
interpolate_sample <- function(df) {
approx(x = df$Strain, y = df$Stress, xout = strain_grid, rule = 1)$y
}
interpolated <- all_data %>%
group_by(material, flow, sample) %>%
group_modify(~ tibble(Strain = strain_grid, Stress = interpolate_sample(.x))) %>%
ungroup()
avg_curves <- interpolated %>%
group_by(material, flow, Strain) %>%
summarise(mean_stress = mean(Stress, na.rm = TRUE),
sd_stress = sd(Stress, na.rm = TRUE),
.groups = "drop") %>%
filter(!is.na(mean_stress))
ggplot(avg_curves, aes(x = Strain*100, y = mean_stress, color = flow, fill = flow)) +
geom_ribbon(aes(ymin = mean_stress - sd_stress, ymax = mean_stress + sd_stress), alpha = 0.15, color = NA) +
geom_line(linewidth = 1) +
facet_wrap(~material) +
labs(x = "Strain (%)", y = "Stress (MPa)",
title = "Average Stress-Strain Curve by Flow % (±1 SD band) — SET-1") +
theme_minimal()
ggsave("average_curves_SET-1.png", width = 10, height = 6, dpi = 150)
# ---- Average plot: one file per material + flow combo ----
combos <- avg_curves %>% distinct(material, flow)
for (i in seq_len(nrow(combos))) {
mat <- combos$material[i]
fl  <- combos$flow[i]
p <- avg_curves %>%
filter(material == mat, flow == fl) %>%
ggplot(aes(x = Strain*100, y = mean_stress)) +
geom_ribbon(aes(ymin = mean_stress - sd_stress, ymax = mean_stress + sd_stress),
alpha = 0.2, fill = "steelblue") +
geom_line(color = "steelblue", linewidth = 1) +
labs(x = "Strain (%)", y = "Stress (MPa)",
title = paste0(mat, " — ", fl, "% flow — Average (n=5) — SET-1")) +
theme_minimal()
print(p)
fname <- paste0("average_SET-1_", gsub(" ", "_", mat), "_", fl, "pct.png")
ggsave(fname, p, width = 7, height = 5, dpi = 150)
}
# ---- Individual plot: one file per single sample ----
combos <- all_data %>% distinct(material, flow, sample)
for (i in seq_len(nrow(combos))) {
mat <- combos$material[i]
fl  <- combos$flow[i]
sm  <- combos$sample[i]
p <- all_data %>%
filter(material == mat, flow == fl, sample == sm) %>%
ggplot(aes(x = Strain*100, y = StressSmooth)) +
geom_line(color = "steelblue", linewidth = 0.9) +
labs(x = "Strain (%)", y = "Stress (MPa)",
title = paste0(mat, " — ", fl, "% flow — Sample ", sm, " — SET-1")) +
theme_minimal()
print(p)
fname <- paste0("sample_SET-1_", gsub(" ", "_", mat), "_", fl, "pct_sample", sm, ".png")
ggsave(fname, p, width = 6, height = 5, dpi = 150)
}
# ---- 1. Low-strain inspection (spot check a few samples) ----
all_data %>%
filter(material == "CF PETG", flow == "100", sample == "1", Strain <= 0.0005) %>%
ggplot(aes(x = Strain*100, y = Stress)) +
geom_point(size = 1) +
geom_line() +
labs(x = "Strain (%)", y = "Stress (MPa)", title = "Low-strain region check — CF PETG 100% sample 1") +
theme_minimal()
# ---- 2. Window comparison ----
candidate_windows <- list(
"ISO_0.05-0.25" = c(0.0005, 0.0025),
"later_0.10-0.30" = c(0.0010, 0.0030),
"later_0.15-0.35" = c(0.0015, 0.0035)
)
window_comparison <- map_dfr(names(candidate_windows), function(wname) {
rng <- candidate_windows[[wname]]
all_data %>%
filter(Strain >= rng[1], Strain <= rng[2]) %>%
group_by(material, flow, sample) %>%
filter(n() >= 5) %>%
summarise(
modulus_GPa = coef(lm(Stress ~ Strain))[2] / 1000,
r2 = summary(lm(Stress ~ Strain))$r.squared,
.groups = "drop"
) %>%
mutate(window = wname)
})
window_summary <- window_comparison %>%
group_by(window) %>%
summarise(
mean_modulus = mean(modulus_GPa),
sd_modulus = sd(modulus_GPa),
mean_r2 = mean(r2),
min_r2 = min(r2),
.groups = "drop"
)
print(window_summary)
# ---- 3. Summary table (update the window filter below once Step 2 confirms which is best) ----
summary_table <- all_data %>%
group_by(material, flow, sample) %>%
summarise(
modulus_GPa = {
w <- cur_data() %>% filter(Strain >= 0.0005, Strain <= 0.0025)   # <- adjust after checking window_summary
coef(lm(Stress ~ Strain, data = w))[2] / 1000
},
tensile_strength_MPa = max(Stress, na.rm = TRUE),
maximum_strain_pct = max(Strain, na.rm = TRUE) * 100,
.groups = "drop"
)
print(summary_table, n = 100)
write_csv(summary_table, "summary_table_SET-1.csv")
# ---- 4. ANOVA + Tukey post-hoc ----
aov_modulus <- aov(modulus_GPa ~ material * flow, data = summary_table)
summary(aov_modulus)
TukeyHSD(aov_modulus)
aov_strength <- aov(tensile_strength_MPa ~ material * flow, data = summary_table)
summary(aov_strength)
TukeyHSD(aov_strength)
aov_strain <- aov(maximum_strain_pct ~ material * flow, data = summary_table)
summary(aov_strain)
TukeyHSD(aov_strain)
