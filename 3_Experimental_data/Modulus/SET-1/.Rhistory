base_plot <- function(data, xmax) {
ggplot(data, aes(x = Strain*100, y = StressSmooth)) +
annotate("rect", xmin = 0.05, xmax = 0.25, ymin = -Inf, ymax = Inf,
alpha = 0.15, fill = "orange") +
geom_line(color = "steelblue", linewidth = 0.9) +
geom_line(data = fit_line, aes(x = Strain*100, y = Stress),
color = "red", linewidth = 1) +
annotate("text", x = 0.25, y = max(data$Stress, na.rm = TRUE) * 0.15,
label = paste0("E = ", E_GPa, " GPa"), color = "red", size = 3.5, hjust = 0) +
xlim(0, xmax) +
labs(x = "Strain (%)", y = "Stress (MPa)") +
theme_minimal()
}
# Full curve
p_full <- base_plot(sample_data, xmax = 0.55) +
labs(title = paste0(mat, " — ", fl, "% flow — Sample ", sm, " (full curve)"))
# Zoomed elastic region
p_zoom <- base_plot(sample_data %>% filter(Strain*100 <= 0.30), xmax = 0.30) +
labs(title = paste0(mat, " — ", fl, "% flow — Sample ", sm, " (zoomed elastic region)"))
fname_base <- paste0(gsub(" ", "_", mat), "_", fl, "pct_sample", sm)
ggsave(paste0("fig1_full_", fname_base, ".png"), p_full, width = 6, height = 5, dpi = 150)
ggsave(paste0("fig1_zoom_", fname_base, ".png"), p_zoom, width = 6, height = 5, dpi = 150)
}
