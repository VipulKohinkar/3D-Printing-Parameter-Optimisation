inner_join(representative_picks, by = c("material", "flow", "sample")) %>%
mutate(flow = factor(flow, levels = c("80", "90", "100", "110")),
StressLightSmooth = zoo::rollmean(Stress, 7, fill = NA, align = "center"))  # light smoothing only - preserves real features like stress drops
plot_material_representative <- function(mat) {
representative_curves %>%
filter(material == mat) %>%
ggplot(aes(x = Strain*100, y = StressLightSmooth, color = flow)) +
geom_line(linewidth = 0.9) +
labs(x = "Strain (%)", y = "Stress (MPa)",
title = paste0(mat, " — Representative Stress-Strain Curves by Flow Rate — SET-1")) +
theme_minimal()
}
