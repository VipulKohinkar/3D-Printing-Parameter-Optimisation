getwd()   # shows current working directory (should still be Pull to Break/SET-1)
list.files(output_dir, pattern = "\\.png$")   # lists every saved image in the Graphs folder
# select representative sample per material+flow using modulus + R² (no failure-mode split needed here - short test, no drawing behavior)
representative_modulus <- summary_table %>%
filter(r2 >= 0.95) %>%
group_by(material, flow) %>%
mutate(
mod_IQR = IQR(modulus_GPa),
mod_z = ifelse(mod_IQR == 0, 0, abs(modulus_GPa - median(modulus_GPa)) / mod_IQR)
) %>%
slice_min(mod_z, n = 1, with_ties = FALSE) %>%
ungroup() %>%
select(material, flow, sample, modulus_GPa, r2)
print(representative_modulus)
verify_modulus_selection <- function(mat, fl) {
group_data <- all_data %>%
filter(material == mat, flow == fl) %>%
group_by(sample) %>%
arrange(Strain, .by_group = TRUE) %>%
mutate(StressSmoothHeavy = rollmean(Stress, 11, fill = NA, align = "center")) %>%
ungroup()
rep_sample <- representative_modulus %>% filter(material == mat, flow == fl) %>% pull(sample)
group_data <- group_data %>% mutate(is_rep = if_else(sample == rep_sample, "Representative", "Other"))
ggplot(group_data, aes(x = Strain*100, y = StressSmoothHeavy, group = sample,
color = is_rep, linewidth = is_rep)) +
geom_line() +
scale_color_manual(values = c("Representative" = "red", "Other" = "grey60")) +
scale_linewidth_manual(values = c("Representative" = 1.2, "Other" = 0.6)) +
labs(title = paste0(mat, " — ", fl, "% flow — All 5 (red = representative)"),
x = "Strain (%)", y = "Stress (MPa)", color = NULL, linewidth = NULL) +
theme_minimal()
}
verify_modulus_selection("CF PETG", "80")
verify_modulus_selection("CF PETG", "90")
verify_modulus_selection("CF PETG", "100")
verify_modulus_selection("CF PETG", "110")
verify_modulus_selection("PETG", "80")
verify_modulus_selection("PETG", "90")
verify_modulus_selection("PETG", "100")
verify_modulus_selection("PETG", "110")
