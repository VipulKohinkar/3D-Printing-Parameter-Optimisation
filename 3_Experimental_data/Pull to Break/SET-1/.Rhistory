df <- read_tsv(f, skip = 1, locale = locale(encoding = "UTF-16LE"),
col_names = c("Time","Load","Ext","Stress","ExtPreload","Strain","PctStrain","GaugeLen"),
show_col_types = FALSE) %>%
drop_na(Stress, Strain, Load) %>% filter(Strain >= cummax(Strain))
smax <- max(df$Stress)
df <- df %>% filter(Stress > 0.02 * smax)
win <- df %>% filter(between(Strain, 0.0005, 0.0025))
if (nrow(win) < 5) {
return(tibble(file = basename(f), material = material, flow = flow, sample = sample, strain0 = NA_real_))
}
fit <- lm(Stress ~ Strain, data = win)
slope <- coef(fit)[2]
tibble(file = basename(f), material = material, flow = flow, sample = sample,
strain0 = if (is.na(slope) || slope <= 0) NA_real_ else -coef(fit)[1]/slope)
}
strain0_table <- map_dfr(files_break, compute_strain0) %>%
group_by(material, flow) %>%
mutate(strain0_final = if_else(is.na(strain0), mean(strain0, na.rm = TRUE), strain0)) %>%
ungroup()
# break-point detection: last point load stays above 20% of peak
detect_break <- function(df) {
load_smooth <- rollmean(df$Load, k = 9, fill = NA, align = "center")
load_smooth[is.na(load_smooth)] <- df$Load[is.na(load_smooth)]
peak_load <- max(load_smooth, na.rm = TRUE)
threshold <- 0.2 * peak_load
above <- load_smooth > threshold
last_above <- max(which(above))
min(last_above + 5, nrow(df))
}
read_clean_break <- function(f) {
parts <- str_split(f, "/")[[1]]
material <- parts[length(parts) - 1]
flow   <- str_extract(basename(f), "\\d+(?=%)")
sample <- str_extract(basename(f), "(?<=_)\\d+(?=\\.txt$)")
fname  <- basename(f)
df <- read_tsv(f, skip = 1, locale = locale(encoding = "UTF-16LE"),
col_names = c("Time","Load","Ext","Stress","ExtPreload","Strain","PctStrain","GaugeLen"),
show_col_types = FALSE) %>%
drop_na(Stress, Strain, Load) %>%
filter(Strain >= cummax(Strain))
smax_initial <- max(df$Stress)
df <- df %>% filter(Stress > 0.02 * smax_initial)
strain0 <- strain0_table %>% filter(file == fname) %>% pull(strain0_final)
df <- df %>% mutate(Strain = Strain - strain0) %>% filter(Strain >= 0)
break_idx <- detect_break(df)
df <- df[1:break_idx, ]
df %>%
mutate(StressSmooth = rollmean(Stress, 5, fill = NA, align = "center"),
material = material, flow = flow, sample = sample, file = fname)
}
all_break_data <- map_dfr(files_break, read_clean_break)
break_summary <- all_break_data %>%
mutate(flow = factor(flow, levels = c("80", "90", "100", "110"))) %>%
group_by(material, flow, sample) %>%
summarise(
UTS_MPa = max(Stress, na.rm = TRUE),
elongation_at_break_pct = max(Strain, na.rm = TRUE) * 100,
.groups = "drop"
)
print(break_summary, n = 100)
# ==================================================================
# PART 3: TOUGHNESS
# ==================================================================
toughness_summary <- all_break_data %>%
group_by(material, flow, sample) %>%
arrange(Strain, .by_group = TRUE) %>%
summarise(toughness_MJ_per_m3 = sum(diff(Strain) * (head(Stress, -1) + tail(Stress, -1)) / 2),
.groups = "drop")
print(toughness_summary, n = 100)
# ==================================================================
# PART 4: COMBINE INTO ONE LONG TABLE
# ==================================================================
properties_long <- summary_table %>%
select(material, flow, sample, modulus_GPa) %>%
left_join(break_summary %>% select(material, flow, sample, UTS_MPa, elongation_at_break_pct),
by = c("material", "flow", "sample")) %>%
left_join(toughness_summary, by = c("material", "flow", "sample")) %>%
pivot_longer(cols = c(modulus_GPa, UTS_MPa, elongation_at_break_pct, toughness_MJ_per_m3),
names_to = "property_type", values_to = "property_value")
print(properties_long, n = 20)
# ==================================================================
# PART 5: SANITY CHECK (per ChatGPT's suggested order - do this before plotting)
# ==================================================================
properties_long %>%
distinct(material, flow, sample, property_type) %>%
count(material, flow, property_type) %>%
filter(n != 5)
# add failure mode classification (per our earlier finding - genuine cold-drawing vs limited elongation)
break_summary <- break_summary %>%
mutate(failure_mode = if_else(elongation_at_break_pct > 20, "Extensive drawing", "Limited/brittle"))
break_summary %>% count(material, flow, failure_mode)
# ---- Modulus & UTS: straightforward mean ± SD, all 5 samples ----
property_labels <- c(
modulus_GPa = "Young's Modulus (GPa)",
UTS_MPa = "UTS (MPa)"
)
plot_simple_property <- function(prop_name) {
plot_data <- properties_long %>%
filter(property_type == prop_name) %>%
group_by(material, flow) %>%
summarise(mean_val = mean(property_value, na.rm = TRUE),
sd_val = sd(property_value, na.rm = TRUE), .groups = "drop")
ggplot(plot_data, aes(x = flow, y = mean_val, color = material, group = material)) +
geom_line(linewidth = 0.9) +
geom_point(size = 2.5) +
geom_errorbar(aes(ymin = mean_val - sd_val, ymax = mean_val + sd_val), width = 0.15) +
labs(x = "Flow Rate (%)", y = property_labels[[prop_name]],
title = paste0(property_labels[[prop_name]], " vs Flow Rate")) +
theme_minimal()
}
p_modulus <- plot_simple_property("modulus_GPa")
p_uts <- plot_simple_property("UTS_MPa")
p_modulus; p_uts
# ---- Elongation & Toughness: boxplot, colored/split by failure mode ----
break_long_flagged <- break_summary %>%
select(material, flow, sample, elongation_at_break_pct, failure_mode) %>%
left_join(toughness_summary, by = c("material", "flow", "sample"))
p_elong <- ggplot(break_long_flagged, aes(x = flow, y = elongation_at_break_pct, fill = material)) +
geom_boxplot(position = position_dodge(0.8), width = 0.6, alpha = 0.6, outlier.shape = NA) +
geom_point(aes(shape = failure_mode), position = position_jitterdodge(jitter.width = 0.1, dodge.width = 0.8), size = 2) +
scale_y_log10() +   # log scale, since values span 2% to 168%
labs(x = "Flow Rate (%)", y = "Elongation at Break (%) [log scale]",
title = "Elongation at Break by Material and Flow Rate",
shape = "Failure Mode") +
theme_minimal()
p_tough <- ggplot(break_long_flagged, aes(x = flow, y = toughness_MJ_per_m3, fill = material)) +
geom_boxplot(position = position_dodge(0.8), width = 0.6, alpha = 0.6, outlier.shape = NA) +
geom_point(aes(shape = failure_mode), position = position_jitterdodge(jitter.width = 0.1, dodge.width = 0.8), size = 2) +
scale_y_log10() +
labs(x = "Flow Rate (%)", y = "Toughness (MJ/m³) [log scale]",
title = "Toughness by Material and Flow Rate",
shape = "Failure Mode") +
theme_minimal()
p_elong; p_tough
