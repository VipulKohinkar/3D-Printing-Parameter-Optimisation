# Step 1: composite distance-from-median score using UTS + elongation together
composite_selection <- break_summary %>%
group_by(material, flow) %>%
mutate(
UTS_z = abs(UTS_MPa - median(UTS_MPa)) / IQR(UTS_MPa),
elong_z = abs(elongation_at_break_pct - median(elongation_at_break_pct)) / IQR(elongation_at_break_pct),
composite_score = UTS_z + elong_z
) %>%
arrange(material, flow, composite_score) %>%
select(material, flow, sample, UTS_MPa, elongation_at_break_pct, composite_score)
print(composite_selection, n = 100)
composite_selection_fixed <- break_summary %>%
group_by(material, flow) %>%
mutate(
UTS_z = abs(UTS_MPa - median(UTS_MPa)) / IQR(UTS_MPa),
elong_z = abs(elongation_at_break_pct - median(elongation_at_break_pct)) / IQR(elongation_at_break_pct),
composite_score = UTS_z + elong_z
) %>%
# keep only the majority failure mode within each group
add_count(failure_mode, name = "mode_count") %>%
filter(mode_count == max(mode_count)) %>%
arrange(material, flow, composite_score) %>%
select(material, flow, sample, UTS_MPa, elongation_at_break_pct, failure_mode, mode_count, composite_score)
print(composite_selection_fixed, n = 100)
representative_picks <- composite_selection_fixed %>%
group_by(material, flow) %>%
slice_min(composite_score, n = 1) %>%
ungroup() %>%
select(material, flow, sample)
